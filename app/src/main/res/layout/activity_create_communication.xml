<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText
        android:id="@+id/editTextCommunicationTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/create_communication_title_hint" />

    <EditText
        android:id="@+id/editTextCommunicationContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="@string/create_communication_content_hint"
        android:inputType="textMultiLine"
        android:minLines="3" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/create_communication_priority_label" />

    <RadioGroup
        android:id="@+id/radioGroupPriority"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <RadioButton
            android:id="@+id/radioButtonNormal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_communication_priority_normal"
            android:checked="true" />

        <RadioButton
            android:id="@+id/radioButtonEmergency"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/create_communication_priority_emergency" />
    </RadioGroup>

    <Button
        android:id="@+id/buttonSendCommunication"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="16dp"
        android:text="@string/create_communication_send_button" />

</LinearLayout>
