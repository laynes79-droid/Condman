<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp">

    <View
        android:id="@+id/priorityIndicator"
        android:layout_width="8dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="16dp"
        tools:background="@android:color/holo_green_light" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/textViewCommunicationTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Título do Comunicado" />

        <TextView
            android:id="@+id/textViewCommunicationSnippet"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            tools:text="Um trecho do conteúdo do comunicado..." />

        <TextView
            android:id="@+id/textViewCommunicationAuthor"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textSize="12sp"
            tools:text="Autor: Nome do Autor" />

        <TextView
            android:id="@+id/textViewCommunicationDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="12sp"
            tools:text="Data: dd/mm/yyyy" />

    </LinearLayout>

</LinearLayout>
